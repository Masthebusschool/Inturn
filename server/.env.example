# Copy this file to server/.env and fill it in. NEVER commit .env.

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local example: mongodb://127.0.0.1:27017/inturn  (MongoDB Atlas connection strings work too)
MONGODB_URI=

JWT_SECRET=replace-with-a-long-random-string

# AI: pick Gemini OR Groq (one key is enough)
GEMINI_API_KEY=
GROQ_API_KEY=

# Job boards: Arbeitnow needs no key. Adzuna needs both values below.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
