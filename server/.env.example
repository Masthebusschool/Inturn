# Copy this file to server/.env and fill it in. NEVER commit .env.

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

GEMINI_API_KEY=
# Speed over scoring accuracy (school project): lite/fast base model, less spacing between calls,
# shorter timeout. See server/src/services/aiGateway.js.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MIN_SPACING_MS=2000
GEMINI_REQUEST_TIMEOUT_MS=45000

# Job boards: Arbeitnow needs no key. Adzuna needs both values below.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
