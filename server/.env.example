# Copy this file to server/.env and fill it in. NEVER commit .env.

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local example: mongodb://127.0.0.1:27017/inturn  (MongoDB Atlas connection strings work too)
MONGODB_URI=

JWT_SECRET=replace-with-a-long-random-string

# AI: pick Gemini OR Groq (one key is enough)
# Chosen: Gemini powers resume parsing + skill-gap analysis (GEMINI_API_KEY). Optional GEMINI_MODEL overrides the default model.
GEMINI_API_KEY=
# Optional Gemini tuning (leave commented to use the defaults shown):
# Default model: resume parsing + tailored resume.
# GEMINI_MODEL=gemini-flash-latest
# Job-description requirement parsing (falls back to GEMINI_MODEL).
# GEMINI_PARSE_MODEL=
# Requirement scorer / judge (falls back to GEMINI_MODEL).
# GEMINI_JUDGE_MODEL=
# Resume parsing (falls back to GEMINI_MODEL). Gemini free-tier quota is tracked per model, so pointing
# this at a different/lighter model (e.g. gemini-flash-lite-latest) gets resume parsing its own quota
# bucket when the main model is rate-limited.
# GEMINI_RESUME_MODEL=
# Min gap between Gemini requests, measured from the end of the previous one (free-tier per-minute limits).
# GEMINI_MIN_SPACING_MS=6000
# Per-request timeout.
# GEMINI_REQUEST_TIMEOUT_MS=90000
# Thinking depth for JD parsing / the judge (MINIMAL|LOW|MEDIUM|HIGH; Gemini 3+ models). Default LOW:
# the model's own default measured ~55-85s per call, too close to the timeout.
# GEMINI_PARSE_THINKING_LEVEL=LOW
# GEMINI_JUDGE_THINKING_LEVEL=LOW

# Job boards: Arbeitnow needs no key. Adzuna needs both values below.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
