# Copy this file to server/.env and fill it in. NEVER commit .env.

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=

SESSION_SECRET=replace-with-a-long-random-string

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MIN_SPACING_MS=2000
GEMINI_REQUEST_TIMEOUT_MS=45000

# Optional: override GEMINI_MODEL for a specific call purpose. Unset falls back to GEMINI_MODEL.
GEMINI_PARSE_MODEL=
GEMINI_JUDGE_MODEL=
GEMINI_RESUME_MODEL=

# Optional: thinking budget per call purpose (LOW/MEDIUM/HIGH). Unset defaults to LOW.
GEMINI_PARSE_THINKING_LEVEL=
GEMINI_JUDGE_THINKING_LEVEL=
GEMINI_RESUME_THINKING_LEVEL=
GEMINI_TAILOR_THINKING_LEVEL=
